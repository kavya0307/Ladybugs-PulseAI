# Copy this file to .env and fill in your key for local development.
# On Render, set this as an Environment Variable in the service settings instead
# (do NOT commit a real key to the repo).

# Required for real AI-powered editorial judgment and post writing.
# Get a key at https://console.anthropic.com
# If this is left unset, the agent automatically falls back to its
# deterministic keyword/template logic - it will never crash or go silent.
ANTHROPIC_API_KEY=

# DEV/DEMO ONLY. Leave unset (or "false") for the actual hackathon submission -
# it hides the manual "Run Cycle Now" button and disables the /api/agent/trigger
# endpoint, so evaluators only ever see genuinely autonomous, scheduler-driven posts.
ALLOW_MANUAL_TRIGGER=false
